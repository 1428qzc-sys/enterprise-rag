# ======================================================================
# Enterprise RAG 环境变量示例
# 复制为 .env 后按需修改： cp .env.example .env
# 所有变量均为可选，未设置时使用代码内默认值。
# ======================================================================

# ---------------- 应用 ----------------
APP_NAME=Enterprise RAG
ENVIRONMENT=development
# 前端地址（CORS）；逗号分隔，"*" 表示放开
CORS_ORIGINS=*

# 服务安全基线
REQUEST_TIMEOUT_SECONDS=60
RATE_LIMIT_REQUESTS_PER_MINUTE=600
WORKER_THREAD_TOKENS=100
URL_FETCH_TIMEOUT_SECONDS=10
URL_FETCH_MAX_REDIRECTS=3
URL_FETCH_MAX_MB=5

# ---------------- 数据库 ----------------
# 本地零配置可留空使用 SQLite；docker-compose 会自动注入 PostgreSQL
# DATABASE_URL=sqlite:///./data/enterprise_rag.db
DATABASE_URL=postgresql+psycopg://rag:ragpwd@postgres:5432/enterprise_rag
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT_SECONDS=30

# ---------------- 向量库 ----------------
# memory=进程内(零依赖，适合本地体验)；qdrant=生产
VECTOR_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=kb_

# Docker Compose 宿主机端口（可选，避免和其他本地项目冲突）
FRONTEND_HOST_PORT=8080
BACKEND_HOST_PORT=8000
QDRANT_HOST_PORT=6333

# 认证 / 多租户（生产环境必须覆盖 AUTH_SECRET_KEY 与管理员密码）
AUTH_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
BOOTSTRAP_TENANT_NAME=Demo Enterprise
BOOTSTRAP_TENANT_SLUG=demo
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_NAME=系统管理员

# ======================================================================
# 模型配置：三选一，取消对应段落注释即可
# ======================================================================

# ---- 方案 A：OpenAI（Embedding + LLM 同一把 key，最省事）----
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=replace-with-openai-api-key
EMBEDDING_DIM=1536
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-openai-api-key

# ---- 方案 B：DeepSeek 做 LLM + OpenAI 做 Embedding（DeepSeek 无 embedding 接口）----
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=replace-with-openai-api-key
# EMBEDDING_DIM=1536
# LLM_PROVIDER=openai
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=replace-with-deepseek-api-key

# ---- 方案 C：全本地 Ollama（无需联网/密钥，需先 ollama pull）----
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIM=1024
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---- 方案 D：离线 smoke / CI（无需密钥，不是真实模型效果）----
# EMBEDDING_PROVIDER=fake
# EMBEDDING_MODEL=fake
# EMBEDDING_DIM=64
# LLM_PROVIDER=echo
# LLM_MODEL=echo

# ---------------- 重排（可选，需安装 requirements-optional.txt）----------------
RERANK_ENABLED=false
RERANK_PROVIDER=none
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_N=5

# ---------------- 分块 ----------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ---------------- 检索 ----------------
VECTOR_TOP_K=20
BM25_TOP_K=20
HYBRID_TOP_K=8
RRF_K=60

# ---------------- RAG ----------------
HISTORY_TURNS=6
MAX_CONTEXT_CHARS=6000

# ---------------- 上传 ----------------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50
