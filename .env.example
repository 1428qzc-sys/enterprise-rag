# Enterprise RAG 本地零密钥演示配置。
# Windows: copy .env.example .env
# macOS/Linux: cp .env.example .env
# 然后运行: docker compose up -d --build --wait
#
# 该文件只适合本机演示。生产环境必须改为 ENVIRONMENT=production，替换认证密钥、
# 管理员密码、数据库密码和 CORS_ORIGINS；应用会拒绝带演示安全配置的生产启动。

# ---------------- 应用 / 宿主机端口 ----------------
APP_NAME=Enterprise RAG
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:19020,http://localhost:19020
FRONTEND_HOST_PORT=19020
BACKEND_HOST_PORT=19021
QDRANT_HOST_PORT=19022
POSTGRES_HOST_PORT=19023
REDIS_HOST_PORT=19024

# ---------------- 数据库 ----------------
POSTGRES_USER=rag
POSTGRES_PASSWORD=ragpwd-local-demo
POSTGRES_DB=enterprise_rag
DATABASE_AUTO_CREATE=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT_SECONDS=30

# 原生 Python 离线运行可改用下列值，并把 DATABASE_AUTO_CREATE 设为 true：
# DATABASE_URL=sqlite:///./data/enterprise_rag.db

# ---------------- 向量库 / 限流 ----------------
VECTOR_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=kb_
RATE_LIMIT_REQUESTS_PER_MINUTE=600
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REDIS_FAILURE_MODE=fail_closed
RATE_LIMIT_KEY_PREFIX=enterprise-rag:ratelimit
REDIS_URL=redis://redis:6379/0

# ---------------- 认证 / 多租户 ----------------
AUTH_SECRET_KEY=local-demo-auth-secret-change-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
BOOTSTRAP_TENANT_NAME=Demo Enterprise
BOOTSTRAP_TENANT_SLUG=demo
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_NAME=系统管理员

# ---------------- 零密钥模型替身 ----------------
# fake + echo 是确定性工程演示，不代表真实模型质量；界面会明确显示 Mock 模式。
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake
EMBEDDING_DIM=256
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
LLM_PROVIDER=echo
LLM_MODEL=echo
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# BYOK 示例（按供应商实际模型和维度覆盖，且不要提交 .env）：
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536
# EMBEDDING_API_KEY=your-provider-key
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=your-provider-key

# ---------------- 检索 / 重排 ----------------
RERANK_ENABLED=true
RERANK_PROVIDER=lexical
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_N=5
VECTOR_TOP_K=20
BM25_TOP_K=20
HYBRID_TOP_K=8
RRF_K=60
VECTOR_MIN_SCORE=0.05
RAG_MIN_EVIDENCE_SCORE=0.11
HISTORY_TURNS=6
MAX_CONTEXT_CHARS=6000
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ---------------- 运行保护 ----------------
REQUEST_TIMEOUT_SECONDS=60
READINESS_TIMEOUT_SECONDS=2
HEALTH_EXTERNAL_CHECKS=true
WORKER_THREAD_TOKENS=100
URL_FETCH_TIMEOUT_SECONDS=10
URL_FETCH_MAX_REDIRECTS=3
URL_FETCH_MAX_MB=5
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50
